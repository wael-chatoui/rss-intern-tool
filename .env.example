# Local personal mode: keep these empty to use a private writable data directory.
RSS_DATA_DIR=
# On Vercel, both values are required. Production refuses ephemeral/file fallback.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Canonical exact origin; previews need their own configuration.
AUTH_ORIGIN=https://rss-intern-tool.vercel.app
APP_BASE_URL=https://rss-intern-tool.vercel.app
# First owner installation only. Generate a 32-byte token, store ONLY its SHA-256
# here, and deliver /activation#token=RAW_TOKEN privately. Never commit the raw token.
AUTH_SETUP_TOKEN_SHA256=
AUTH_SETUP_EXPIRES_AT=
OWNER_RESERVED_EMAIL=
# Open only after seller details, isolation and real Stripe test-mode checkout pass.
PUBLIC_SIGNUP_ENABLED=0
BILLING_ENABLED=0
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_WEBHOOK_SECRET=
# Monthly price: EUR 590, inclusive, recurring month/1, licensed, per_unit.
# Its active product must have metadata.application=la-redaction. No Stripe Tax.
